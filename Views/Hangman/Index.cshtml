@* Views/Hangman/Index.cshtml *@
@model HangmanWeb.Models.HangmanState
@using System.Text.Json
@using System.Linq

@{
    ViewData["Title"] = "Виселица";
    
    // Сериализуем состояние для передачи в скрытом поле
    var stateJson = JsonSerializer.Serialize(Model);
    
    // Формируем строку для отображения слова (угаданные буквы или подчеркивания)
    var displayWord = "";
    foreach (var c in Model.Word)
    {
        displayWord += Model.Guessed.Contains(c) ? c + " " : "_ ";
    }

    int errors = Model.Wrong.Count;
    bool isWin = Model.Word.All(c => Model.Guessed.Contains(c));
    bool isLose = errors >= 6;
    string alphabet = "АБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ";

    // Функция для отрисовки виселицы (ASCII-графика)
    string GetHangman(int err)
    {
        string[] stages = {
            "  +---+\n  |   |\n      |\n      |\n      |\n      |\n=========",
            "  +---+\n  |   |\n  O   |\n      |\n      |\n      |\n=========",
            "  +---+\n  |   |\n  O   |\n  |   |\n      |\n      |\n=========",
            "  +---+\n  |   |\n  O   |\n /|   |\n      |\n      |\n=========",
            "  +---+\n  |   |\n  O   |\n /|\\  |\n      |\n      |\n=========",
            "  +---+\n  |   |\n  O   |\n /|\\  |\n /    |\n      |\n=========",
            "  +---+\n  |   |\n  O   |\n /|\\  |\n / \\  |\n      |\n========="
        };
        return stages[Math.Min(err, 6)];
    }
}

<style>
    body { font-family: 'Segoe UI', sans-serif; text-align: center; margin-top: 30px; background-color: #f4f4f9; }
    h1 { color: #333; }
    pre { font-size: 22px; line-height: 1.2; display: inline-block; text-align: left; background: #fff; padding: 20px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
    .word { font-size: 36px; letter-spacing: 8px; margin: 30px 0; font-family: monospace; font-weight: bold; color: #2c3e50; }
    .alphabet { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; max-width: 600px; margin: 0 auto; }
    button { 
        width: 45px; height: 45px; font-size: 18px; cursor: pointer; 
        border: none; border-radius: 5px; background-color: #3498db; color: white;
        transition: background 0.2s;
    }
    button:hover:not(:disabled) { background-color: #2980b9; }
    button:disabled { background-color: #bdc3c7; cursor: not-allowed; color: #7f8c8d; }
    .win { color: #27ae60; font-size: 24px; font-weight: bold; }
    .lose { color: #e74c3c; font-size: 24px; font-weight: bold; }
    .btn-restart { display: inline-block; margin-top: 20px; padding: 10px 20px; background: #2ecc71; color: white; text-decoration: none; border-radius: 5px; font-size: 18px;}
    .btn-restart:hover { background: #27ae60; }
</style>

<h1>Игра "Виселица"</h1>

<pre>@GetHangman(errors)</pre>

<div class="word">@displayWord</div>

@if (isWin)
{
    <p class="win">Поздравляем! Вы угадали слово.</p>
    <a asp-action="Index" class="btn-restart">Играть снова</a>
}
else if (isLose)
{
    <p class="lose">Вы проиграли! Загаданное слово: <strong>@Model.Word</strong></p>
    <a asp-action="Index" class="btn-restart">Играть снова</a>
}
else
{
    <form asp-action="Guess" method="post">
    @* Передаем состояние простыми строками. Это на 100% надежно и не ломается при кодировке *@
    @Html.Hidden("word", Model.Word)
    @Html.Hidden("guessed", string.Join(",", Model.Guessed))
    @Html.Hidden("wrong", string.Join(",", Model.Wrong))
    
    <div class="alphabet">
        @foreach (char c in alphabet)
        {
            var letter = c.ToString();
            // Блокируем кнопки уже названных букв
            var isDisabled = Model.Guessed.Contains(c) ? "disabled" : "";
            <button type="submit" name="letter" value="@letter" @isDisabled>@letter</button>
        }
    </div>
</form>
}